<?php /** @var $block \Magento\Checkout\Block\Onepage\Success */ ?>


<div class="bb-success">

    <div class="bb-success__header">

        <div class="bb-success__icon">
            ✓
        </div>

        <h1>Order Confirmed</h1>

        <p class="bb-success__intro">
            Thank you for shopping with BeautyBop.
            Your order has been received and we'll begin preparing it shortly.
        </p>

    </div>

    <?php if ($block->getOrderId()): ?>

        <div class="bb-success__card">

            <h2>Order Details</h2>

            <?php if ($block->getCanViewOrder()): ?>

                <p>
                    <strong>Order Number</strong><br>

                    <a class="bb-success__order"
                       href="<?= $block->escapeUrl($block->getViewOrderUrl()) ?>">

                        #<?= $block->escapeHtml($block->getOrderId()) ?>

                    </a>

                </p>

            <?php else: ?>

                <p>
                    <strong>Order Number</strong><br>

                    <span class="bb-success__order">

                        #<?= $block->escapeHtml($block->getOrderId()) ?>

                    </span>

                </p>

            <?php endif; ?>

        </div>

    <?php endif; ?>

    <div class="bb-success__card">

        <h2>What happens next?</h2>

        <ul class="bb-success__steps">

            <li>Confirmation email sent.</li>

            <li>Your order is now being prepared.</li>

            <li>We'll send tracking details as soon as your order has been dispatched.</li>

        </ul>

    </div>

    <?= $block->getAdditionalInfoHtml() ?>

    <div class="bb-success__actions">

        <a class="action primary continue"
           href="<?= $block->escapeUrl($block->getContinueUrl()) ?>">

            Continue Shopping

        </a>

    </div>

</div>

<?php
$orderId = $block->getOrderId();
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$order = $objectManager->create('Magento\Sales\Model\Order')->loadByIncrementId($orderId);

if ($order && $order->getId()):
$items = $order->getAllVisibleItems();
?>

<script>
window.dataLayer = window.dataLayer || [];

window.ga4MagentoPurchase = {
    transaction_id: "<?= $block->escapeJs($order->getIncrementId()); ?>",
    value: <?= number_format((float) $order->getGrandTotal(), 2, '.', '') ?>,
    currency: "<?= $block->escapeJs($order->getOrderCurrencyCode()); ?>",
    items: [
        <?php foreach ($items as $item): ?>
        {
            item_id: "<?= $block->escapeJs($item->getSku()); ?>",
            item_name: "<?= $block->escapeJs($item->getName()); ?>",
            price: <?= number_format((float) $item->getPrice(), 2, '.', '') ?>,
            quantity: <?= (int) $item->getQtyOrdered(); ?>
        },
        <?php endforeach; ?>
    ]
};

window.dataLayer.push({
    event: 'purchase',
    ecommerce: window.ga4MagentoPurchase
});

console.log(
    'GTM purchase pushed:',
    window.ga4MagentoPurchase
);
</script>

<?php endif; ?>

