<?xml version="1.0"?>
<page layout="1column"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>

        <!-- Remove Magento's original category heading -->
        <referenceBlock name="page.main.title" remove="true"/>

        <!-- Remove the original category description from above the hero -->
        <referenceBlock name="category.description" remove="true"/>

        <!-- Remove unnecessary sidebar blocks -->
        <referenceBlock name="catalog.compare.sidebar" remove="true"/>
        <referenceBlock name="wishlist_sidebar" remove="true"/>

        <!-- Remove breadcrumbs -->
        <referenceBlock name="breadcrumbs" remove="true"/>

        
        <referenceContainer name="content">

            <block
                class="Magento\Framework\View\Element\Template"
                name="beautybop.brand.hero"
                template="Magento_Catalog::category/brand/hero.phtml"
                before="category.products"
            />

            <block
                class="Magento\Framework\View\Element\Template"
                name="beautybop.brand.collections"
                template="Magento_Catalog::category/brand/collections.phtml"
                after="beautybop.brand.hero"
                before="category.products"
            />

        </referenceContainer>

        <referenceContainer name="content">
            <container name="brand.product.filters"
                    htmlTag="div"
                    htmlClass="brand-product-filters"
                    before="category.products"/>
        </referenceContainer>

        <move element="catalog.leftnav"
            destination="brand.product.filters"/>

        
        <referenceContainer name="content">
            
            <block class="Magento\Framework\View\Element\Template"
            name="brand.buying.guide"
            template="Magento_Catalog::category/brand/buying-guide.phtml"
            after="category.products">

                <arguments>
                    <argument name="brand_name"
                            xsi:type="string">Hugo Boss</argument>

                    <argument name="title"
                            xsi:type="string">Hugo Boss Aftershave &amp; Perfume Buying Guide</argument>

                    <argument name="intro"
                            xsi:type="string">Discover the right Hugo Boss fragrance for your style, from fresh everyday scents to warm and sophisticated fragrances for evenings and special occasions.</argument>

                    <argument name="fragrances"
                            xsi:type="array">

                        <item name="boss_bottled"
                            xsi:type="array">
                            <item name="name"
                                xsi:type="string">Boss Bottled</item>

                            <item name="description"
                                xsi:type="string">A modern and versatile fragrance range with fresh fruit, warm spice and woody notes.</item>

                            <item name="best_for"
                                xsi:type="string">Everyday wear, work and smart occasions</item>

                            <item name="notes"
                                xsi:type="string">Apple, cinnamon and sandalwood</item>
                        </item>

                        <item name="boss_the_scent"
                            xsi:type="array">
                            <item name="name"
                                xsi:type="string">Boss The Scent</item>

                            <item name="description"
                                xsi:type="string">A warmer and more seductive fragrance collection designed for confident evening wear.</item>

                            <item name="best_for"
                                xsi:type="string">Dates, evenings and colder seasons</item>

                            <item name="notes"
                                xsi:type="string">Ginger, maninka fruit and leather</item>
                        </item>

                        <item name="hugo_man"
                            xsi:type="array">
                            <item name="name"
                                xsi:type="string">Hugo Man</item>

                            <item name="description"
                                xsi:type="string">A fresh and energetic fragrance with a clean, modern character.</item>

                            <item name="best_for"
                                xsi:type="string">Daily wear, spring and summer</item>

                            <item name="notes"
                                xsi:type="string">Green apple, aromatic herbs and woods</item>
                        </item>

                    </argument>

                    <argument name="recommendations"
                            xsi:type="array">

                        <item name="fresh"
                            xsi:type="array">
                            <item name="style"
                                xsi:type="string">Fresh and energetic</item>
                            <item name="range"
                                xsi:type="string">Hugo Man</item>
                        </item>

                        <item name="everyday"
                            xsi:type="array">
                            <item name="style"
                                xsi:type="string">Versatile everyday fragrance</item>
                            <item name="range"
                                xsi:type="string">Boss Bottled</item>
                        </item>

                        <item name="warm"
                            xsi:type="array">
                            <item name="style"
                                xsi:type="string">Warm and sophisticated</item>
                            <item name="range"
                                xsi:type="string">Boss The Scent</item>
                        </item>

                        <item name="intense"
                            xsi:type="array">
                            <item name="style"
                                xsi:type="string">Rich evening fragrance</item>
                            <item name="range"
                                xsi:type="string">Boss Bottled Elixir</item>
                        </item>

                    </argument>

                    <argument name="edt_description"
                            xsi:type="string">A fresher and lighter option that works particularly well for daytime, work and warmer weather.</argument>

                    <argument name="edp_description"
                            xsi:type="string">A richer fragrance concentration with greater depth, making it well suited to evenings and cooler weather.</argument>
                </arguments>
            </block>

        </referenceContainer>


        <block class="Magento\Framework\View\Element\Template"
        name="brand.faq"
        template="Magento_Catalog::category/brand/faq.phtml">

            <arguments>
                <argument name="brand_name"
                        xsi:type="string">Hugo Boss</argument>

                <argument name="title"
                        xsi:type="string">Hugo Boss Fragrance FAQs</argument>

                <argument name="intro"
                        xsi:type="string">Find answers to common questions about choosing and wearing Hugo Boss aftershave and perfume.</argument>

                <argument name="faqs"
                        xsi:type="array">

                    <item name="longest_lasting"
                        xsi:type="array">
                        <item name="question"
                            xsi:type="string">Which Hugo Boss fragrance lasts the longest?</item>

                        <item name="answer"
                            xsi:type="string">Richer fragrances such as Boss Bottled Elixir and Boss The Scent Elixir are designed with greater depth and are generally better suited to customers looking for a longer-lasting scent.</item>
                    </item>

                    <item name="most_popular"
                        xsi:type="array">
                        <item name="question"
                            xsi:type="string">What is the most popular Hugo Boss aftershave?</item>

                        <item name="answer"
                            xsi:type="string">Boss Bottled is one of the best-known Hugo Boss fragrance ranges. Its fruity, spicy and woody character makes it a versatile choice for everyday wear.</item>
                    </item>

                    <item name="everyday"
                        xsi:type="array">
                        <item name="question"
                            xsi:type="string">Is Hugo Boss Bottled suitable for everyday wear?</item>

                        <item name="answer"
                            xsi:type="string">Yes. Boss Bottled has a versatile fragrance profile that works well for daytime, work, casual occasions and smart events.</item>
                    </item>

                    <item name="difference"
                        xsi:type="array">
                        <item name="question"
                            xsi:type="string">What is the difference between Boss Bottled and Boss The Scent?</item>

                        <item name="answer"
                            xsi:type="string">Boss Bottled is generally fresh, fruity and woody, while Boss The Scent has a warmer and more seductive character that is particularly suited to evenings.</item>
                    </item>

                    <item name="summer"
                        xsi:type="array">
                        <item name="question"
                            xsi:type="string">Which Hugo Boss fragrance is best for warmer weather?</item>

                        <item name="answer"
                            xsi:type="string">Fresh and aromatic fragrances such as Hugo Man can work particularly well during spring and summer because of their lighter, energetic character.</item>
                    </item>

                </argument>
            </arguments>
        </block>

        <move element="brand.faq"
            destination="content"
            after="brand.buying.guide"/>

    </body>
</page>